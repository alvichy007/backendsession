// File: db.js
const { Pool } = require("pg");
require("dotenv").config();

const pool = new Pool({
  connectionString: process.env.SUPABASE_DB_URL,
});

module.exports = pool;

// File: models/userModel.js
const db = require("../db");

async function createUser(name, email, hashedPassword) {
  return db.query(
    "INSERT INTO users (name, email, password) VALUES ($1, $2, $3)",
    [name, email, hashedPassword]
  );
}

async function findUserByEmail(email) {
  const res = await db.query("SELECT * FROM users WHERE email = $1", [email]);
  return res.rows[0];
}

module.exports = { createUser, findUserByEmail };

// File: models/todoModel.js
const db = require("../db");

async function getTodosByUserId(userId) {
  const res = await db.query("SELECT * FROM todos WHERE user_id = $1", [userId]);
  return res.rows;
}

async function createTodo(userId, title) {
  return db.query("INSERT INTO todos (user_id, title) VALUES ($1, $2)", [userId, title]);
}

async function deleteTodoById(todoId, userId) {
  return db.query("DELETE FROM todos WHERE id = $1 AND user_id = $2", [todoId, userId]);
}

module.exports = { getTodosByUserId, createTodo, deleteTodoById };

// File: controllers/authController.js
const bcrypt = require("bcrypt");
const jwt = require("jsonwebtoken");
const { createUser, findUserByEmail } = require("../models/userModel");

async function register(req, res) {
  const { name, email, password } = req.body;
  const hashedPassword = await bcrypt.hash(password, 10);
  await createUser(name, email, hashedPassword);
  res.json({ message: "User registered successfully" });
}

async function login(req, res) {
  const { email, password } = req.body;
  const user = await findUserByEmail(email);
  if (!user) return res.status(401).json({ error: "Invalid credentials" });

  const match = await bcrypt.compare(password, user.password);
  if (!match) return res.status(401).json({ error: "Invalid credentials" });

  const token = jwt.sign({ id: user.id }, process.env.JWT_SECRET);
  res.json({ token });
}

module.exports = { register, login };

// File: controllers/todoController.js
const { getTodosByUserId, createTodo, deleteTodoById } = require("../models/todoModel");

async function getTodos(req, res) {
  const userId = req.user.id;
  const todos = await getTodosByUserId(userId);
  res.json(todos);
}

async function addTodo(req, res) {
  const userId = req.user.id;
  const { title } = req.body;
  await createTodo(userId, title);
  res.json({ message: "Todo added" });
}

async function deleteTodo(req, res) {
  const userId = req.user.id;
  const todoId = req.params.id;
  await deleteTodoById(todoId, userId);
  res.json({ message: "Todo deleted" });
}

module.exports = { getTodos, addTodo, deleteTodo };

// File: middleware/authMiddleware.js
const jwt = require("jsonwebtoken");

function authMiddleware(req, res, next) {
  const token = req.header("Authorization");
  if (!token) return res.status(401).json({ error: "Access denied" });

  try {
    const verified = jwt.verify(token, process.env.JWT_SECRET);
    req.user = verified;
    next();
  } catch (err) {
    res.status(400).json({ error: "Invalid token" });
  }
}

module.exports = authMiddleware;

// File: routes/authRoutes.js
const express = require("express");
const router = express.Router();
const { register, login } = require("../controllers/authController");

router.post("/register", register);
router.post("/login", login);

module.exports = router;

// File: routes/todoRoutes.js
const express = require("express");
const router = express.Router();
const { getTodos, addTodo, deleteTodo } = require("../controllers/todoController");
const authMiddleware = require("../middleware/authMiddleware");

router.use(authMiddleware);
router.get("/", getTodos);
router.post("/", addTodo);
router.delete("/:id", deleteTodo);

module.exports = router;

// File: swagger.js
const swaggerJsDoc = require("swagger-jsdoc");
const swaggerUi = require("swagger-ui-express");

const options = {
  definition: {
    openapi: "3.0.0",
    info: {
      title: "Todo API",
      version: "1.0.0",
    },
  },
  apis: ["./routes/*.js"],
};

const swaggerSpec = swaggerJsDoc(options);

function setupSwagger(app) {
  app.use("/docs", swaggerUi.serve, swaggerUi.setup(swaggerSpec));
}

module.exports = setupSwagger;

// File: app.js
const express = require("express");
const app = express();
const authRoutes = require("./routes/authRoutes");
const todoRoutes = require("./routes/todoRoutes");
const setupSwagger = require("./swagger");
require("dotenv").config();

app.use(express.json());
app.use("/auth", authRoutes);
app.use("/todos", todoRoutes);
setupSwagger(app);

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`Server running on port ${PORT}`));
